# Persistence (PostgreSQL is the production default). If unset, an in-memory
# repository is used (tests / first run only). Host port 5433 (not 5432) to
# match docker-compose.yml -- avoids silently colliding with another local
# Postgres on the default port (confirmed live: docker starts the container
# but never binds the port, so DATABASE_URL:5432 would hit a DIFFERENT
# project's database instead of erroring).
DATABASE_URL=postgresql+psycopg2://malagent:malagent@localhost:5433/malagent

# Cloud provider keys (optional; only needed when escalating to that provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Local model (Ollama). qwen3:8b and gemma4:12b are the two models this
# project's own research actually evaluated (docs/RESEARCH.md) -- qwen3:8b
# has the best coverage (84.9%), gemma4:12b the best local FPR (8.3%).
# scripts/install-full.{ps1,sh} pulls both; set whichever you'll use by
# default here, or pass --judge-model to pick per-run.
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=qwen3:8b

# Full prompt/response logging for prompt-quality iteration (optional,
# unset by default -- separate from the audit trail, which deliberately
# only ever records a prompt HASH, never the actual content). Appends one
# JSON line per model call (system, full prompt, response, error) to this
# path. The logged content includes untrusted, attacker-controllable text
# extracted from the sample -- treat this file as sensitive, same as any
# other artifact derived from an unknown binary.
MAL_AGENT_PROMPT_LOG_PATH=

# capa (optional; enables capability/ATT&CK triage + Ghidra function ranking).
# `pip install flare-capa` does NOT bundle the rules or FLIRT signatures --
# download them separately and point capa at them, or it fails with
# "default embedded rules not found":
#   rules: https://github.com/mandiant/capa-rules/releases (match your capa version)
#   sigs:  https://github.com/mandiant/capa/tree/master/sigs
CAPA_RULES_PATH=
CAPA_SIGS_PATH=

# Headless Ghidra (optional; enables per-function decompilation, M2).
# Set to the Ghidra install root (the dir containing support/analyzeHeadless).
GHIDRA_HOME=

# Known-good hash allowlist (optional; skips the expensive stages entirely on
# a match -- verified live: ~1s instead of several minutes). Plain
# hash-per-line file, or "hash,name" CSV -- an NIST NSRL RDS export works
# directly. Absence is reported honestly (not configured), never silently
# treated as "not trusted".
KNOWN_GOOD_HASHES_PATH=

# IOC reputation blocklists (optional; local, zero-egress cross-reference of
# IPs/domains/URLs already extracted by StaticFeaturesTool against
# threat-intel lists you download yourself -- never bundled into this repo
# since sources like hagezi/dns-blocklists are GPL-3.0 and this project is
# MIT). Plain-text, one entry per line, '#' comments allowed:
#   IPs:     https://github.com/ShadowWhisperer/IPs
#   domains: https://github.com/hagezi/dns-blocklists (Threat Intelligence Feeds subset)
IP_BLOCKLIST_PATH=
DOMAIN_BLOCKLIST_PATH=

# YARA rule matching (optional; distinct from this project's own YARA rule
# GENERATION, which always runs -- this MATCHES a rule set you supply
# against the sample). `pip install yara-python`. Point at a single
# .yar/.yara file or a directory of them. Never bundled into this repo --
# third-party rule sets carry their own licenses.
YARA_RULES_PATH=

# VirusTotal hash lookup (optional; NOT live-verified in this project's own
# development -- no API key was available to test against the real API).
# Needs BOTH this key AND EgressPolicy.allow_hash_lookup=True (a separate,
# deliberate opt-in -- see docs/ARCHITECTURE.md Sec 7) before any lookup
# actually runs. `pip install requests`.
VIRUSTOTAL_API_KEY=

# EMBER2024 pretrained classifier (optional; see docs/ML_CLASSIFIER_PLAN.md).
# A real, trained-on-3.2M-files ML classifier that produces a genuine
# P(malicious) probability -- when configured, this REPLACES the
# deterministic corroboration gate as the verdict authority (binary
# malicious/benign, no "undetermined"); the gate's own findings still
# corroborate/explain but no longer decide. Point at a downloaded
# EMBER2024_*.model file (github.com/FutureComputing4AI/EMBER2024,
# Apache-2.0): `pip install thrember` (from that repo; also needs
# `pip install "signify==0.7.1"` specifically -- thrember pins
# signify>=0.7.1 with no upper bound, and the latest signify release
# renamed the class thrember imports, a real dependency-drift bug found
# live during setup), then `thrember.download_models(dir)` or download
# individual ~3.5MB `.model` files directly from
# huggingface.co/joyce8/EMBER2024-benchmark-models.
EMBER_MODEL_PATH=
